{
  "schema_version": 1,
  "label": "Converter efficiency sweep",
  "description": "Sweep input voltage and output load current; calculate efficiency from mean input and output power.",
  "parameters": {
    "input_start_v": {
      "label": "Input start",
      "unit": "V",
      "default": 8.0,
      "min": 0.01,
      "max": 1000.0,
      "step": 0.5,
      "type": "number"
    },
    "input_stop_v": {
      "label": "Input stop",
      "unit": "V",
      "default": 12.0,
      "min": 0.01,
      "max": 1000.0,
      "step": 0.5,
      "type": "number"
    },
    "input_step_v": {
      "label": "Input step",
      "unit": "V",
      "default": 2.0,
      "min": 0.001,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "load_start_a": {
      "label": "Load start",
      "unit": "A",
      "default": 0.1,
      "min": 0.0,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "load_stop_a": {
      "label": "Load stop",
      "unit": "A",
      "default": 1.0,
      "min": 0.0,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "load_step_a": {
      "label": "Load step",
      "unit": "A",
      "default": 0.3,
      "min": 0.001,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "settle_s": {
      "label": "Settling time",
      "unit": "s",
      "default": 1.0,
      "min": 0.1,
      "max": 3600.0,
      "step": 0.1,
      "type": "number"
    },
    "samples_per_point": {
      "label": "Samples per point",
      "unit": "",
      "default": 1,
      "min": 1,
      "max": 100,
      "step": 1,
      "type": "integer"
    },
    "current_limit_a": {
      "label": "Supply current limit",
      "unit": "A",
      "default": 3.0,
      "min": 0.001,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "nominal_output_v": {
      "label": "Expected output",
      "unit": "V",
      "default": 5.0,
      "min": 0.001,
      "max": 1000.0,
      "step": 0.1,
      "type": "number"
    },
    "tolerance_pct": {
      "label": "Output regulation tolerance",
      "unit": "%",
      "default": 5.0,
      "min": 0.1,
      "max": 50.0,
      "step": 0.5,
      "type": "number"
    }
  },
  "axes": [
    {
      "id": "input_voltage_set_v",
      "label": "Input voltage setpoint",
      "unit": "V",
      "role": "supply",
      "control": "voltage",
      "start": "input_start_v",
      "stop": "input_stop_v",
      "step": "input_step_v"
    },
    {
      "id": "load_current_set_a",
      "label": "Load current setpoint",
      "unit": "A",
      "role": "load",
      "control": "current",
      "start": "load_start_a",
      "stop": "load_stop_a",
      "step": "load_step_a"
    }
  ],
  "setup": [
    {
      "role": "supply",
      "control": "current_limit",
      "value": "current_limit_a"
    }
  ],
  "before_point": [
    {
      "role": "load",
      "control": "current",
      "value": 0
    }
  ],
  "outputs": [
    "supply",
    "load"
  ],
  "limits": {
    "supply": {
      "voltage": "input_stop_v",
      "current": "current_limit_a"
    },
    "load": {
      "voltage": "nominal_output_v * (1 + tolerance_pct / 100)",
      "current": "load_stop_a"
    }
  },
  "acquisition": {
    "settle_s": "settle_s",
    "samples": "samples_per_point",
    "repeat": 1,
    "capture_all": false,
    "on_invalid": "fail"
  },
  "measurements": {
    "input_voltage_v": {
      "label": "Input voltage",
      "unit": "V",
      "role": "supply",
      "quantity": "voltage",
      "required": true
    },
    "input_current_a": {
      "label": "Input current",
      "unit": "A",
      "role": "supply",
      "quantity": "current",
      "required": true
    },
    "output_voltage_v": {
      "label": "Output voltage",
      "unit": "V",
      "role": "load",
      "quantity": "voltage",
      "required": true
    },
    "output_current_a": {
      "label": "Output current",
      "unit": "A",
      "role": "load",
      "quantity": "current",
      "required": true
    }
  },
  "derived": {
    "input_power_w": {
      "label": "Input power",
      "unit": "W",
      "expression": "input_voltage_v * input_current_a",
      "aggregate": "sample_mean"
    },
    "output_power_w": {
      "label": "Output power",
      "unit": "W",
      "expression": "output_voltage_v * output_current_a",
      "aggregate": "sample_mean"
    },
    "efficiency_pct": {
      "label": "Efficiency",
      "unit": "%",
      "expression": "100 * output_power_w / input_power_w",
      "aggregate": "point"
    },
    "in_regulation": {
      "label": "In regulation",
      "unit": "",
      "expression": "abs(output_voltage_v - nominal_output_v) <= nominal_output_v * tolerance_pct / 100",
      "aggregate": "point"
    }
  },
  "checks": [
    {
      "stage": "sample",
      "expression": "input_voltage_v >= 0 and input_current_a >= 0 and output_voltage_v >= 0 and output_current_a >= 0",
      "message": "Unexpected negative DC readback; sweep stopped"
    },
    {
      "stage": "sample",
      "expression": "output_voltage_v <= nominal_output_v * (1 + tolerance_pct / 100)",
      "message": "Output exceeded the configured voltage tolerance"
    },
    {
      "stage": "sample",
      "expression": "input_current_a <= current_limit_a * 1.05",
      "message": "Input current exceeded the configured limit"
    },
    {
      "stage": "point",
      "expression": "in_regulation",
      "message": "Output fell outside the configured regulation tolerance"
    }
  ],
  "plots": [
    {
      "kind": "line",
      "data": "points",
      "x": "output_current_a",
      "y": "efficiency_pct",
      "series": "input_voltage_set_v",
      "title": "Efficiency versus output current",
      "x_scale": "linear",
      "y_scale": "linear"
    }
  ],
  "table": {
    "data": "points"
  }
}
